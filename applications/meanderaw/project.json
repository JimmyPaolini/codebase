{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "meanderaw",
  "projectType": "application",
  "sourceRoot": "applications/meanderaw",
  "tags": [
    "domain:meanderaw",
    "framework:nest-commander",
    "framework:nestjs",
    "generator:nestjs-command-project",
    "language:typescript",
    "type:application"
  ],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "options": {
        "assets": [
          {
            "glob": "README.md",
            "input": "applications/meanderaw",
            "output": "."
          }
        ],
        "generatePackageJson": false,
        "main": "applications/meanderaw/src/main.ts",
        "outputPath": "applications/meanderaw/dist",
        "tsConfig": "applications/meanderaw/tsconfig.build.json"
      },
      "outputs": ["{options.outputPath}"]
    },
    "codometer": {},
    "dependency-cruiser": {},
    "knip": {},
    "lint-codebase": {},
    "make-projects": {},
    "markdown-lint": {},
    "oxfmt": {},
    "oxlint": {},
    "prettier": {},
    "repl": {
      "cache": false,
      "description": "Start an interactive NestJS REPL for Meanderaw services",
      "executor": "nx:run-commands",
      "options": {
        "command": "node --import @swc-node/register/esm-register src/repl.ts",
        "cwd": "{projectRoot}"
      }
    },
    "spell-check": {},
    "start": {
      "cache": false,
      "description": "Run the Meanderaw application. With no arguments it sweeps every meander into output/meanders.sqlite — the whole lattice's unit space, enumerated and classified, then the historical corpus's hardcoded Codes beyond that budget; with --args=\"--rows <n> --columns <n> --code <code>\" it writes that one row. `build` compiles this project rather than drawing anything, so populating the database is this target's job.",
      "executor": "nx:run-commands",
      "options": {
        "command": "node --import @swc-node/register/esm-register src/main.ts {args}",
        "cwd": "{projectRoot}"
      }
    },
    "test-coverage": {},
    "type-coverage": {},
    "typecheck": {},
    "yaml-lint": {}
  }
}
