{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "lexico-api",
  "projectType": "application",
  "sourceRoot": "applications/lexico-api",
  "tags": [
    "domain:lexico",
    "framework:nestjs",
    "framework:nestjs-graphql-api",
    "generator:nestjs-graphql-application",
    "language:typescript",
    "type:application"
  ],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "options": {
        "assets": [
          {
            "glob": "README.md",
            "input": "applications/lexico-api",
            "output": "."
          }
        ],
        "generatePackageJson": false,
        "main": "applications/lexico-api/src/main.ts",
        "outputPath": "applications/lexico-api/dist",
        "tsConfig": "applications/lexico-api/tsconfig.build.json"
      },
      "outputs": ["{options.outputPath}"]
    },
    "codometer": {},
    "dependency-cruiser": {},
    "deprecate-code": {},
    "format-code": {},
    "guard-code": {},
    "knip": {},
    "lint-code": {},
    "markdown-lint": {},
    "oxfmt": {},
    "oxlint": {},
    "prettier": {},
    "spell-check": {},
    "start": {
      "description": "Start the LexicoApi GraphQL API",
      "executor": "nx:run-commands",
      "options": {
        "command": "node --import @swc-node/register/esm-register src/main.ts",
        "cwd": "{projectRoot}"
      }
    },
    "test-code": {},
    "type-coverage": {},
    "typecheck": {},
    "typecheck-code": {},
    "yaml-lint": {}
  }
}
