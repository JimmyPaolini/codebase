{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "{{nameKebabCase}}",
  "projectType": "library",
  "sourceRoot": "{{type}}/{{nameKebabCase}}",
  "tags": [
    "framework:nestjs",
    "generator:nestjs-service-project",
    "language:typescript",
    "name:{{nameKebabCase}}",
    "type:package"
  ],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "options": {
        "assets": [
          {
            "glob": "README.md",
            "input": "{{type}}/{{nameKebabCase}}",
            "output": "."
          }
        ],
        "main": "{{type}}/{{nameKebabCase}}/src/index.ts",
        "outputPath": "dist/{{type}}/{{nameKebabCase}}",
        "tsConfig": "{{type}}/{{nameKebabCase}}/tsconfig.json"
      },
      "outputs": [
        "{options.outputPath}"
      ]
    },
    "dependency-cruiser": {},
    "knip": {},
    "lint-codebase": {},
    "make-projects": {},
    "markdown-lint": {},
    "oxfmt": {},
    "oxlint": {},
    "prettier": {},
    "spell-check": {},
    "test-coverage": {},
    "type-coverage": {},
    "typecheck": {},
    "vitest": {},
    "yaml-lint": {}
  }
}
