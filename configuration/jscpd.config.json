{
  "gitignore": true,
  "ignore": [
    "**/.git/**",
    "**/.nx/**",
    "**/coverage/**",
    "**/dist/**",
    "**/node_modules/**",
    "**/output/**",
    "**/pnpm-lock.yaml",
    "**/tmp/**",
    "tools/conformance/src/modules/*/templates/**"
  ],
  "minLines": 12,
  "minTokens": 24,
  "mode": "mild",
  "reporters": ["console", "threshold"],
  "threshold": 6
}
