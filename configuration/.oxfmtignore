# Conformetry example fixtures: a template file holds mustache where an
# identifier belongs, so it is not parseable as the language its extension
# names. Each example's own conformetry.config.ts is formatted normally.
**/packages/conformetry-examples/examples/*/instances/**
**/packages/conformetry-examples/examples/*/templates/**
# Emitted from the conformetry configuration; the emitter's output is
# authoritative, and reformatting it makes every conformetry command fail the
# drift check after a `format` run.
**/.conformetry/**
**/data/wikipedia
**/data/wiktionary
yarn.lock
