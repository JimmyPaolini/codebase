{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "audit": {
    "cacheMaxAgeDays": 7,
    "deadCodeBaseline": null,
    "gate": "all",
    "healthBaseline": null,
  },
  "duplicates": {
    "crossLanguage": true,
    "ignore": ["packages/*/src/modules/database/migrations/**/*.ts"],
    "ignoreDefaults": true,
    "ignoreImports": true,
    "minLines": 12,
    "minOccurrences": 2,
    "minTokens": 24,
    "mode": "mild",
    "skipLocal": true,
    "threshold": 6,
  },
  "entry": [
    "**/.size-limit.cjs",
    "**/scripts/**/*.{js,mjs,ts,sh}",
    ".pnpmfile.mjs",
    "{applications,packages,tools}/*/src/index.ts",
    "{applications,packages,tools}/*/src/main.ts",
    "{applications,packages,tools}/*/src/modules/**/*.module.ts",
    // Nx resolves these from executors.json and generators.json, which is not
    // an import, so nothing reaches them through the module graph.
    "{applications,packages,tools}/*/src/executors/**/executor.ts",
    "{applications,packages,tools}/*/src/generators/**/generator.ts",
    "{applications,packages,tools}/*/src/generators.ts",
    "{applications,packages,tools}/*/src/repl.ts",
    "{applications,packages,tools}/*/testing/**/*.ts",
    "configuration/**",
    "packages/lexico-entities/src/modules/database/migrations/**/*.ts",
    "release.config.cjs",
    "validate-branch-name.config.cjs",
  ],
  "health": {
    "coverage": "coverage/coverage-final.json",
    "coverageRoot": null,
    "crapRefactorBand": 3,
    "ignore": [
      "**/__generated__/**",
      "**/.conformetry/**",
      "**/coverage/**",
      "**/dist/**",
      "**/src/lib/database.types.ts",
      "**/src/routeTree.gen.ts",
    ],
    "maxCognitive": 12,
    "maxCrap": 16,
    "maxCyclomatic": 8,
    "ownership": {
      "botPatterns": [
        "*\\[bot\\]*",
        "*-service-account*",
        "dependabot*",
        "github-actions*",
        "renovate*",
        "svc-*",
      ],
      "emailMode": "handle",
    },
    "suggestInlineSuppression": false,
    "thresholdOverrides": [],
  },
  "ignoreDependencies": [
    "@caelundas/src",
    "@caelundas/testing",
    "@commitlint/config-conventional",
    "@golevelup/ts-vitest",
    "@conformetry/nx",
    "@nx/eslint-plugin",
    "@nx/js",
    "@nx/vitest",
    "@nx/web",
    "@photostructure/tz-lookup",
    "@semantic-release/changelog",
    "@semantic-release/commit-analyzer",
    "@semantic-release/git",
    "@semantic-release/github",
    "@semantic-release/npm",
    "@semantic-release/release-notes-generator",
    "@size-limit/file",
    "@swc/helpers",
    "@swc-node/register",
    "@testcontainers/postgresql",
    "@typescript-eslint/parser",
    "commitlint-plugin-gitmoji",
    "commitlint-plugin-tense",
    "jiti",
    "license-checker",
    "lodash",
    "markdownlint-cli2",
    "openwiki",
    "pg",
    "pino-pretty",
    "pluralize",
    "squawk-cli",
    "stylelint",
    "stylelint-config-standard",
    "stylelint-config-tailwindcss",
    "tailwindcss-animate",
    "tslib",
    "tsx",
    "type-coverage",
    "typeorm-naming-strategies",
    "unplugin-swc",
    "vitest",
    "zod",
  ],
  "ignoreExports": [
    {
      "exports": ["typedObjectKeys"],
      "file": "**/src/modules/caelundas/caelundas.symbol-constants.ts",
    },
    {
      "exports": ["*"],
      "file": "**/src/routeTree.gen.ts",
    },
    {
      "exports": ["*"],
      "file": "**/src/lib/database.types.ts",
    },
    {
      "exports": ["*"],
      "file": "**/src/lib/auth.ts",
    },
    {
      "exports": ["*"],
      "file": "**/src/lib/bookmarks.ts",
    },
    {
      "exports": ["*"],
      "file": "**/src/lib/supabase.ts",
    },
    {
      "exports": ["*"],
      "file": "**/src/modules/database/database.module.ts",
    },
    {
      "exports": ["*"],
      "file": "**/src/modules/entities/entities.module.ts",
    },
  ],
  "ignoreExportsUsedInFile": true,
  "ignorePatterns": [
    "**/*.min.js",
    "**/.agents/skills/**",
    "**/.agents/licenses/**",
    "**/.claude/skills/**",
    "**/.conformetry/**",
    "**/.github/skills/**/scripts/**",
    "**/.nx/**",
    "**/.opencode/skills/**/scripts/**",
    "**/.terraform/**",
    "**/.venv/**",
    "**/applications/lexico-ingestion/data/**",
    "**/applications/lexico-ingestion/src/modules/library/library.constants.ts",
    "**/applications/lexico-ingestion/src/modules/literature/literature.constants.ts",
    "**/build/**",
    "**/conformetry-templates/**",
    "**/coverage/**",
    "**/data/library/**",
    "**/data/wikipedia/**",
    "**/data/wiktionary/**",
    "**/dist/**",
    "**/helm/**/templates/**",
    "**/library.json",
    "**/node_modules/**",
    "**/pnpm-lock.yaml",
    "**/src/**/*.constants.ts",
    "**/src/**/*.types.ts",
    "**/src/lib/database.types.ts",
    "**/src/routeTree.gen.ts",
    "**/testing/**",
    "**/tmp/**",
    "**/vite.config.*.timestamp*",
    "**/vitest.config.*.timestamp*",
    ".claude/skills/**",
    ".github/copilot-instructions.md",
    ".github/skills/**",
    "applications/affirmations/**",
    "applications/JimmyPaolini/**",
    "CHANGELOG.md",
    "CLAUDE.md",
    "notepads/**",
  ],
  "publicPackages": [],
  "rules": {
    "boundary-violation": "warn",
    "circular-dependencies": "warn",
    "coverage-gaps": "warn",
    "prop-drilling": "warn",
    "re-export-cycle": "warn",
    "thin-wrapper": "warn",
    "unprovided-injects": "warn",
    "unresolved-imports": "warn",
    "unused-dependencies": "warn",
    "unused-exports": "warn",
    "unused-files": "warn",
    "unused-types": "warn",
  },
  "usedClassMembers": [
    {
      "extends": "CommandRunner",
      "members": ["parseDirectory", "parseReadme", "run"],
    },
    {
      "extends": "ConsoleLogger",
      "members": ["debug", "error", "log", "setContext", "verbose", "warn"],
    },
    "ingest",
  ],
}
