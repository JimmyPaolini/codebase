set -e

# ⏱️ Log timestamp
TIMESTAMP=$(date '+%Y-%m-%d %H:%M:%S %z')
printf '[%s] pre-commit\n' "$TIMESTAMP"

# 🔐 Check GPG git signing configuration
REPOSITORY_ROOT="$(git rev-parse --show-toplevel)"
"$REPOSITORY_ROOT/scripts/git/check-commit-signing-configuration.sh"

# 🗒️ Clear notepads
git restore --staged notepads/notepad.jsonc || true
git restore --staged notepads/notepad.md || true
git restore --staged notepads/notepad.py || true
git restore --staged notepads/notepad.sh || true
git restore --staged notepads/notepad.sql || true
git restore --staged notepads/notepad.ts || true

EXIT_CODE=0

# `nx sync:check` used to run here. The generator plugin it checked is no longer
# committed — it is emitted into .conformetry on install — so no commit can
# stage it out of date. Every conformetry command re-checks the emitted plugin
# against the configuration and refuses to run against a stale one instead.

# 📏 Measure code
nx run codebase:codometer:write || EXIT_CODE=$?
git add README.md

# 🧹 Check staged files
# NODE_OPTIONS deliberately unset: it is inherited by every command lint-staged
# runs, and a `--import=tsx` loader preempts the transpiler Nx uses for
# workspace plugins. esbuild emits no `design:paramtypes`, so the conformetry
# plugin's NestJS constructor injection would silently resolve to `undefined`
# and the project graph would fail to build. Node reads the TypeScript config
# natively.
NX_PERF_LOGGING=false lint-staged --config configuration/lint-staged.config.ts --continue-on-error > last-lint-staged-output.log 2>&1 || EXIT_CODE=$?

# 💀 Explain a kill rather than leaving lint-staged's misleading wording
# Exit 137 is SIGKILL. lint-staged reports it as "Task failed to spawn:
# undefined", which sends you looking at PATH and argument length; the real
# cause is the operating system reclaiming memory from the analysis run.
if [ "${EXIT_CODE}" = "137" ] || grep -q "Task failed to spawn" last-lint-staged-output.log 2>/dev/null; then
  printf '\n⚠️  A check was killed rather than failing.\n'
  printf '   This is the operating system reclaiming memory, not a spawn error.\n'
  printf '   Free some memory and commit again, or run the analysis directly:\n'
  printf '   nx affected --target=analyze-code --configuration=check --parallel=1 --files=<staged paths>\n\n'
fi

# 🖨️ Log output
LAST_LINT_STAGED_OUTPUT=$(cat last-lint-staged-output.log \
  | grep -vE '\(node:[0-9]+\) Warning: The .NO_COLOR' \
  | grep -vE '\(Use .node --trace-warnings' \
  | grep -vE 'Your AI agent configuration is outdated' \
  | perl -pe 's/\x1B\[[0-9;]*[a-zA-Z]//g' \
  | perl -0777 -pe 's/\n{3,}/\n\n/g')

printf "%s\n" "$LAST_LINT_STAGED_OUTPUT"
printf '[%s] pre-commit\n%s\n' "$TIMESTAMP" "$LAST_LINT_STAGED_OUTPUT" > last-lint-staged-output.log

# 🚫 Exit
exit "$EXIT_CODE"
