{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "analytics": false,
  "bail": false,
  "cacheDirectory": ".nx/cache",
  "defaultBase": "main",
  "defaultProject": "codebase",
  "generators": {
    "@nx/react": {
      "application": {
        "babel": true,
        "bundler": "vite",
        "linter": "eslint",
        "style": "tailwind"
      },
      "component": {
        "style": "tailwind"
      },
      "library": {
        "linter": "eslint",
        "style": "tailwind"
      }
    }
  },
  "namedInputs": {
    "default": [
      "!{projectRoot}/.eslintcache/**",
      "{projectRoot}/**/*",
      "shared-globals"
    ],
    "dependency-versions": [
      "{workspaceRoot}/pnpm-lock.yaml",
      "{workspaceRoot}/pnpm-workspace.yaml"
    ],
    "production": [
      "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
      "!{projectRoot}/tsconfig.spec.json",
      "default"
    ],
    "python-source": [
      "{projectRoot}/**/*.ipynb",
      "{projectRoot}/**/*.py",
      "{projectRoot}/pyproject.toml",
      "{workspaceRoot}/uv.lock"
    ],
    "python-tests": ["{projectRoot}/testing/**/*.py"],
    "shared-globals": ["{workspaceRoot}/configuration/tsconfig.json"],
    "typescript-files": [
      "{projectRoot}/**/*.{ts,tsx,mts,cts}",
      "{projectRoot}/**/*.json",
      "{projectRoot}/tsconfig*.json",
      "shared-globals"
    ]
  },
  "neverConnectToCloud": true,
  "parallel": 3,
  "plugins": [
    {
      "options": {
        "buildTargetName": "build",
        "devTargetName": "develop",
        "typecheckTargetName": "typecheck"
      },
      "plugin": "@nx/vite/plugin"
    },
    {
      "options": {
        "targetName": "eslint"
      },
      "plugin": "@nx/eslint/plugin"
    },
    {
      "options": {
        "testMode": "run",
        "testTargetName": "vitest"
      },
      "plugin": "@nx/vitest"
    },
    {
      "options": {
        "configurationPath": "configuration/conformetry.config.ts",
        "validateTargetName": "conformetry-validate"
      },
      "plugin": "@conformetry/nx"
    },
    {
      "options": {
        "configurationPath": "configuration/callidescope.config.ts"
      },
      "plugin": "@callidescope/nx"
    }
  ],
  "projects": {
    "caelundas": {
      "tags": ["domain:caelundas", "language:typescript", "type:application"]
    },
    "codebase": {
      "tags": ["language:typescript", "type:tool"]
    }
  },
  "sync": {
    "globalGenerators": ["@conformetry/nx:sync"]
  },
  "targetDefaults": {
    "bandit": [
      {
        "cache": true,
        "executor": "nx:run-commands",
        "filter": {
          "projects": ["tag:language:python"]
        },
        "inputs": [
          "{workspaceRoot}/pyproject.toml",
          "{workspaceRoot}/uv.lock",
          "python-source"
        ],
        "options": {
          "command": "uv run bandit -c pyproject.toml -r src/",
          "cwd": "{projectRoot}"
        }
      }
    ],
    "build": [
      {
        "cache": true,
        "dependsOn": ["^build"],
        "filter": {
          "projects": ["tag:language:python", "tag:language:typescript"]
        },
        "inputs": ["^production", "dependency-versions", "production"]
      }
    ],
    "codometer": {
      "cache": true,
      "configurations": {
        "check": {
          "command": "node --import @swc-node/register/esm-register packages/codometer-cli/src/main.ts measure --directory {projectRoot} --write --check limits"
        },
        "write": {
          "command": "node --import @swc-node/register/esm-register packages/codometer-cli/src/main.ts measure --directory {projectRoot} --readme README.md --write"
        }
      },
      "defaultConfiguration": "check",
      "dependsOn": ["build"],
      "description": "Measure one project and gate the limit it declares, writing the report the pull request's \u23f2\ufe0f Codometer section reads. This default depends on `build` because size analysis reads compiled output; the workspace-root `codebase:codometer` target must NOT, because it measures source and waiting on every build would be both slow and circular \u2014 it pins `dependsOn` to an empty list of its own so this default can never reach it, and neither half of that asymmetry may be collapsed into the other. The report destination is declared in the shared configuration object rather than passed here, because it is the same path for every project; `--readme` stays on the command line because only `write` may pass it. Both configurations pass `--write` because a configured destination without it renders to the console and leaves the file unwritten \u2014 codometer refuses that command line outright, so a target that loses `--write` fails here rather than contributing nothing to the \u23f2\ufe0f Codometer section and looking like a project that changed nothing; `check` adds `--check limits` so a breach fails only after the report is on disk. Neither checks staleness: project READMEs are written on main by the release workflow, so they are expected to be stale on a branch. The report this target writes is subtracted from its own inputs, because `production` would otherwise glob it back in and every run would rewrite the hash it was just cached under \u2014 a local run could never hit its own cache, and a fresh checkout could never match one. `README.md` stays an input despite also being an output: codometer measures markdown, so an edit to it genuinely changes the measurement, and restoring it from cache writes back the identical bytes.",
      "executor": "nx:run-commands",
      "inputs": [
        "!{projectRoot}/codometer-report.json",
        "^production",
        "{workspaceRoot}/codometer.config.ts",
        "{workspaceRoot}/configuration/.codometerignore",
        "{workspaceRoot}/configuration/codometer.config.ts",
        "production"
      ],
      "options": {
        "cwd": "{workspaceRoot}"
      },
      "outputs": [
        "{projectRoot}/codometer-report.json",
        "{projectRoot}/README.md"
      ]
    },
    "dependency-cruiser": [
      {
        "cache": true,
        "executor": "nx:run-commands",
        "filter": {
          "projects": ["tag:language:typescript"]
        },
        "inputs": [
          "^default",
          "{projectRoot}/**/*.ts",
          "{projectRoot}/**/*.tsx",
          "{workspaceRoot}/configuration/dependency-cruiser.cjs",
          "default",
          {
            "externalDependencies": ["dependency-cruiser"]
          }
        ],
        "options": {
          "command": "depcruise {projectRoot}/src --config configuration/dependency-cruiser.cjs",
          "cwd": "{workspaceRoot}"
        }
      }
    ],
    "eslint": [
      {
        "cache": true,
        "configurations": {
          "check": {
            "command": "eslint . --cache --cache-strategy content --cache-location \"$NX_WORKSPACE_ROOT/.eslintcache/\""
          },
          "write": {
            "args": "--fix"
          }
        },
        "defaultConfiguration": "check",
        "filter": {
          "projects": ["tag:language:typescript"]
        },
        "inputs": [
          "!{projectRoot}/.eslintcache/**",
          "{projectRoot}/**/*.{ts,tsx,js,jsx,mts,cts,mjs,cjs,json,jsonc,json5,html,css,scss,md,mdx,yaml,yml}",
          "{workspaceRoot}/configuration/codebase-structure.json",
          "{workspaceRoot}/configuration/eslint.config.ts",
          "shared-globals",
          {
            "externalDependencies": [
              "@eslint/js",
              "@eslint/markdown",
              "@eslint-react/eslint-plugin",
              "@nx/eslint-plugin",
              "@vitest/eslint-plugin",
              "eslint",
              "eslint-config-prettier",
              "eslint-plugin-better-max-params",
              "eslint-plugin-import-x",
              "eslint-plugin-jsdoc",
              "eslint-plugin-jsonc",
              "eslint-plugin-jsx-a11y",
              "eslint-plugin-perfectionist",
              "eslint-plugin-project-structure",
              "eslint-plugin-tsdoc",
              "eslint-plugin-unicorn",
              "eslint-plugin-yml",
              "typescript",
              "typescript-eslint"
            ]
          }
        ],
        "options": {
          "command": "eslint . {args}"
        }
      }
    ],
    "fallow": [
      {
        "cache": true,
        "description": "Inert for every project today: this entry has no options.command and no project.json besides the root codebase project declares its own fallow target for Nx to merge it into, so it never resolves to a runnable target anywhere else. Only wire it up with a command once fallow is meant to run per-project; until then the root-level fallow targets in the codebase project's own project.json, which scan the whole repository, are what actually runs.",
        "executor": "nx:run-commands",
        "filter": {
          "projects": ["tag:language:typescript"]
        },
        "inputs": [
          "{projectRoot}/**/*.{ts,tsx,js,jsx,mts,cts,mjs,cjs}",
          "{workspaceRoot}/configuration/fallow.config.jsonc",
          "shared-globals",
          {
            "externalDependencies": ["fallow"]
          }
        ]
      }
    ],
    "fallow-audit": [
      {
        "cache": false,
        "description": "Inert for every project today: this entry has no options.command and no project.json besides the root codebase project declares its own fallow-audit target for Nx to merge it into, so it never resolves to a runnable target anywhere else. Only wire it up with a command once fallow-audit is meant to run per-project; until then the root-level fallow-audit target in the codebase project's own project.json, which scans the whole repository, is what actually runs.",
        "executor": "nx:run-commands",
        "filter": {
          "projects": ["tag:language:typescript"]
        },
        "inputs": [
          "{projectRoot}/**/*.{ts,tsx,js,jsx,mts,cts,mjs,cjs}",
          "{workspaceRoot}/configuration/fallow.config.jsonc",
          "shared-globals",
          {
            "externalDependencies": ["fallow"]
          }
        ]
      }
    ],
    "fallow-dead-code": [
      {
        "cache": true,
        "description": "Inert for every project today: this entry has no options.command and no project.json besides the root codebase project declares its own fallow-dead-code target for Nx to merge it into, so it never resolves to a runnable target anywhere else. Only wire it up with a command once fallow-dead-code is meant to run per-project; until then the root-level fallow-dead-code target in the codebase project's own project.json, which scans the whole repository, is what actually runs.",
        "executor": "nx:run-commands",
        "filter": {
          "projects": ["tag:language:typescript"]
        },
        "inputs": [
          "{projectRoot}/**/*.{ts,tsx,js,jsx,mts,cts,mjs,cjs}",
          "{workspaceRoot}/configuration/fallow.config.jsonc",
          "shared-globals",
          {
            "externalDependencies": ["fallow"]
          }
        ]
      }
    ],
    "fallow-duplicates": [
      {
        "cache": true,
        "description": "Inert for every project today: this entry has no options.command and no project.json besides the root codebase project declares its own fallow-duplicates target for Nx to merge it into, so it never resolves to a runnable target anywhere else. Only wire it up with a command once fallow-duplicates is meant to run per-project; until then the root-level fallow-duplicates target in the codebase project's own project.json, which scans the whole repository, is what actually runs.",
        "executor": "nx:run-commands",
        "filter": {
          "projects": ["tag:language:typescript"]
        },
        "inputs": [
          "{projectRoot}/**/*.{ts,tsx,js,jsx,mts,cts,mjs,cjs}",
          "{workspaceRoot}/configuration/fallow.config.jsonc",
          "shared-globals",
          {
            "externalDependencies": ["fallow"]
          }
        ]
      }
    ],
    "fallow-health": [
      {
        "cache": true,
        "description": "Inert for every project today: this entry has no options.command and no project.json besides the root codebase project declares its own fallow-health target for Nx to merge it into, so it never resolves to a runnable target anywhere else. Only wire it up with a command once fallow-health is meant to run per-project; until then the root-level fallow-health target in the codebase project's own project.json, which scans the whole repository, is what actually runs.",
        "executor": "nx:run-commands",
        "filter": {
          "projects": ["tag:language:typescript"]
        },
        "inputs": [
          "{projectRoot}/**/*.{ts,tsx,js,jsx,mts,cts,mjs,cjs}",
          "{workspaceRoot}/configuration/fallow.config.jsonc",
          "shared-globals",
          {
            "externalDependencies": ["fallow"]
          }
        ]
      }
    ],
    "knip": [
      {
        "cache": true,
        "configurations": {
          "check": {
            "command": "knip --config configuration/knip.config.ts --workspace {projectRoot}"
          },
          "write": {
            "command": "knip --fix --config configuration/knip.config.ts --workspace {projectRoot}"
          }
        },
        "defaultConfiguration": "check",
        "executor": "nx:run-commands",
        "filter": {
          "projects": ["tag:language:typescript"]
        },
        "inputs": [
          "{workspaceRoot}/configuration/knip.config.ts",
          "default",
          {
            "externalDependencies": ["knip", "typescript"]
          }
        ],
        "options": {
          "command": "knip --config configuration/knip.config.ts --workspace {projectRoot}",
          "cwd": "{workspaceRoot}"
        }
      }
    ],
    "lint-codebase": {
      "cache": false,
      "configurations": {
        "check": {},
        "write": {}
      },
      "defaultConfiguration": "check",
      "dependsOn": [
        "check-catalog-manifests",
        "check-lockfile",
        "check-readme-projects",
        "conformetry-validate",
        "dependency-cruiser",
        "eslint",
        "fallow-dead-code",
        "knip",
        "markdown-lint",
        "nbstripout",
        "oxfmt",
        "oxlint",
        "ruff-format",
        "ruff-lint",
        "sherif",
        "spell-check",
        "sqlfluff-format",
        "sqlfluff-lint",
        "squawk",
        "stylelint",
        "sync-vscode-extensions",
        "syncpack",
        "type-coverage",
        "typecheck",
        "vulture",
        "yaml-lint"
      ],
      "description": "Static code analysis: every check that reads the source without executing it. An nx:noop aggregator \u2014 the work is the dependsOn targets, which Nx schedules in one graph rather than spawning a process per tool. `codebase:codometer`, `codebase:callidescope`, and every synchronization command on the `synchronization` project are deliberately not among them: `codometer` and `callidescope` each publish a report on the default branch, and Nx forwards an explicit configuration down `dependsOn`, so listing one here would make `--configuration=write` publish that report from a branch. Each synchronization command is its own Nx target rather than a shared aggregate, for the same reason. What each one gates is named directly by whatever gates it instead: `callidescope:check` and each derivation synchronization's own `:check` join this target in one `nx affected` invocation, in the Lint Codebase workflow and in `configuration/lint-staged.config.ts` alike, and the per-project `codometer` limits belong to Make Projects, which builds first. A pull request and a commit therefore still trace depth and check derivation drift \u2014 what this target alone no longer covers, the invocation around it does.",
      "executor": "nx:noop"
    },
    "make-projects": {
      "cache": false,
      "dependsOn": ["build", "codometer"],
      "description": "Build every buildable project and measure it. An nx:noop aggregator; `build` carries its own ^build dependency, and `codometer` gates each project's declared limit.",
      "executor": "nx:noop"
    },
    "markdown-lint": [
      {
        "cache": true,
        "configurations": {
          "check": {
            "command": "markdownlint-cli2 --config configuration/.markdownlint-cli2.jsonc '{projectRoot}/**/*.md'"
          },
          "write": {
            "command": "markdownlint-cli2 --fix --config configuration/.markdownlint-cli2.jsonc '{projectRoot}/**/*.md'"
          }
        },
        "defaultConfiguration": "check",
        "executor": "nx:run-commands",
        "filter": {
          "projects": ["tag:language:python", "tag:language:typescript"]
        },
        "inputs": [
          "{projectRoot}/**/*.md",
          "{workspaceRoot}/configuration/.markdownlint-cli2.jsonc",
          "shared-globals",
          {
            "externalDependencies": ["markdownlint-cli2"]
          }
        ],
        "options": {
          "command": "markdownlint-cli2 --config configuration/.markdownlint-cli2.jsonc '{projectRoot}/**/*.md'",
          "cwd": "{workspaceRoot}"
        }
      }
    ],
    "nbstripout": [
      {
        "cache": true,
        "configurations": {
          "check": {
            "args": "--verify"
          },
          "write": {
            "args": ""
          }
        },
        "defaultConfiguration": "check",
        "executor": "nx:run-commands",
        "filter": {
          "projects": ["tag:language:python"]
        },
        "inputs": [
          "{projectRoot}/src/**/*.ipynb",
          "{workspaceRoot}/pyproject.toml",
          "{workspaceRoot}/uv.lock"
        ],
        "options": {
          "command": "find src -name '*.ipynb' -exec uv run nbstripout {args} {} +",
          "cwd": "{projectRoot}"
        }
      }
    ],
    "oxfmt": [
      {
        "cache": true,
        "configurations": {
          "check": {
            "args": "--check"
          },
          "write": {
            "args": "--write"
          }
        },
        "defaultConfiguration": "check",
        "executor": "nx:run-commands",
        "filter": {
          "projects": ["tag:language:typescript"]
        },
        "inputs": [
          "{projectRoot}/**/*.{ts,tsx,js,jsx,mts,cts,mjs,cjs,json,jsonc,json5,html,css,scss,md,mdx,yaml,yml}",
          "{workspaceRoot}/configuration/.oxfmtignore",
          "{workspaceRoot}/configuration/oxfmt.config.ts",
          "shared-globals",
          {
            "externalDependencies": ["oxfmt"]
          }
        ],
        "options": {
          "command": "oxfmt -c configuration/oxfmt.config.ts --ignore-path configuration/.oxfmtignore {args} {projectRoot}",
          "cwd": "{workspaceRoot}"
        }
      }
    ],
    "oxlint": [
      {
        "cache": true,
        "configurations": {
          "check": {},
          "write": {
            "args": "--fix"
          }
        },
        "defaultConfiguration": "check",
        "executor": "nx:run-commands",
        "filter": {
          "projects": ["tag:language:typescript"]
        },
        "inputs": [
          "{projectRoot}/**/*.{ts,tsx,js,jsx,mts,cts,mjs,cjs}",
          "{workspaceRoot}/configuration/.oxlintignore",
          "{workspaceRoot}/configuration/oxlint.config.ts",
          "shared-globals",
          {
            "externalDependencies": ["oxlint"]
          }
        ],
        "options": {
          "command": "oxlint --config configuration/oxlint.config.ts --ignore-path configuration/.oxlintignore {args} {projectRoot}/src",
          "cwd": "{workspaceRoot}"
        }
      }
    ],
    "prettier": [
      {
        "cache": true,
        "configurations": {
          "check": {
            "args": "--check"
          },
          "write": {
            "args": "--write"
          }
        },
        "defaultConfiguration": "write",
        "executor": "nx:run-commands",
        "filter": {
          "projects": ["tag:language:typescript"]
        },
        "inputs": [
          "{projectRoot}/**/*.{ts,tsx,js,jsx,mts,cts,mjs,cjs,json,jsonc,json5,html,css,scss,md,mdx,yaml,yml}",
          "{workspaceRoot}/configuration/.prettierignore",
          "{workspaceRoot}/configuration/prettier.config.ts",
          "shared-globals",
          {
            "externalDependencies": ["prettier"]
          }
        ],
        "options": {
          "command": "prettier {args} --config configuration/prettier.config.ts --ignore-path configuration/.prettierignore {projectRoot}"
        }
      }
    ],
    "pyright": [
      {
        "cache": true,
        "executor": "nx:run-commands",
        "filter": {
          "projects": ["tag:language:python"]
        },
        "inputs": [
          "{workspaceRoot}/pyproject.toml",
          "{workspaceRoot}/uv.lock",
          "python-source"
        ],
        "options": {
          "command": "uv run pyright src/",
          "cwd": "{projectRoot}"
        }
      }
    ],
    "pytest": [
      {
        "cache": true,
        "configurations": {
          "coverage": {
            "command": "uv run pytest --cov=src --cov-report=xml:coverage/python.xml --cov-report=term-missing"
          },
          "integration": {
            "command": "uv run pytest -m integration"
          },
          "unit": {
            "command": "uv run pytest -m unit"
          },
          "watch": {
            "command": "uv run pytest-watch"
          }
        },
        "executor": "nx:run-commands",
        "filter": {
          "projects": ["tag:language:python"]
        },
        "inputs": [
          "{workspaceRoot}/pyproject.toml",
          "{workspaceRoot}/uv.lock",
          "python-source",
          "python-tests"
        ],
        "options": {
          "command": "uv run pytest",
          "cwd": "{projectRoot}"
        }
      }
    ],
    "repl": [
      {
        "cache": false,
        "description": "Start a Nest Commander application in REPL mode",
        "executor": "nx:run-commands",
        "filter": {
          "projects": ["tag:framework:nest-commander"]
        },
        "options": {
          "command": "node --import @swc-node/register/esm-register src/repl.ts",
          "cwd": "{projectRoot}"
        }
      }
    ],
    "ruff-format": [
      {
        "cache": true,
        "configurations": {
          "check": {
            "args": "--check"
          },
          "write": {}
        },
        "defaultConfiguration": "check",
        "executor": "nx:run-commands",
        "filter": {
          "projects": ["tag:language:python"]
        },
        "inputs": [
          "{workspaceRoot}/pyproject.toml",
          "{workspaceRoot}/uv.lock",
          "python-source"
        ],
        "options": {
          "command": "uv run ruff format {args} .",
          "cwd": "{projectRoot}"
        }
      }
    ],
    "ruff-lint": [
      {
        "cache": true,
        "configurations": {
          "check": {},
          "write": {
            "args": "--fix"
          }
        },
        "defaultConfiguration": "check",
        "executor": "nx:run-commands",
        "filter": {
          "projects": ["tag:language:python"]
        },
        "inputs": [
          "{workspaceRoot}/pyproject.toml",
          "{workspaceRoot}/uv.lock",
          "python-source"
        ],
        "options": {
          "command": "uv run ruff check {args} .",
          "cwd": "{projectRoot}"
        }
      }
    ],
    "scan-security": {
      "cache": false,
      "dependsOn": [
        "bandit",
        "gitleaks",
        "license-check",
        "pnpm-audit",
        "trivy-config"
      ],
      "description": "Security scanning: secrets, Python AST, dependency vulnerabilities, licenses, and infrastructure misconfiguration. An nx:noop aggregator.",
      "executor": "nx:noop"
    },
    "spell-check": [
      {
        "cache": true,
        "executor": "nx:run-commands",
        "filter": {
          "projects": ["tag:language:python", "tag:language:typescript"]
        },
        "inputs": [
          "{projectRoot}/**/*.{ts,tsx,js,jsx,mts,cts,mjs,cjs,json,jsonc,json5,css,scss,html,yaml,yml,md,mdx,py,ipynb,sql}",
          "{workspaceRoot}/configuration/.cspell/**",
          "{workspaceRoot}/configuration/cspell.config.yaml",
          "shared-globals",
          {
            "externalDependencies": ["cspell"]
          }
        ],
        "options": {
          "command": "cspell --config configuration/cspell.config.yaml '{projectRoot}/**/*.{ts,tsx,js,jsx,mts,cts,mjs,cjs,json,jsonc,json5,css,scss,html,yaml,yml,md,mdx,py,ipynb,sql}' --no-progress --gitignore --gitignore-root .",
          "cwd": "{workspaceRoot}"
        }
      }
    ],
    "sqlfluff-format": [
      {
        "cache": true,
        "configurations": {
          "check": {
            "args": "lint"
          },
          "write": {
            "args": "fix"
          }
        },
        "defaultConfiguration": "check",
        "executor": "nx:run-commands",
        "filter": {
          "projects": ["tag:framework:typeorm"]
        },
        "inputs": [
          "{projectRoot}/**/*.sql",
          "{workspaceRoot}/pyproject.toml",
          "{workspaceRoot}/uv.lock",
          "shared-globals"
        ],
        "options": {
          "command": "uv run sqlfluff {args} --config pyproject.toml {projectRoot}",
          "cwd": "{workspaceRoot}"
        }
      }
    ],
    "sqlfluff-lint": [
      {
        "cache": true,
        "configurations": {
          "check": {
            "args": "lint"
          },
          "write": {
            "args": "fix"
          }
        },
        "defaultConfiguration": "check",
        "executor": "nx:run-commands",
        "filter": {
          "projects": ["tag:framework:typeorm"]
        },
        "inputs": [
          "{projectRoot}/**/*.sql",
          "{workspaceRoot}/pyproject.toml",
          "{workspaceRoot}/uv.lock",
          "shared-globals"
        ],
        "options": {
          "command": "uv run sqlfluff {args} --config pyproject.toml {projectRoot}",
          "cwd": "{workspaceRoot}"
        }
      }
    ],
    "squawk": [
      {
        "cache": true,
        "executor": "nx:run-commands",
        "filter": {
          "projects": ["tag:framework:typeorm"]
        },
        "inputs": [
          "{projectRoot}/**/*.sql",
          "{workspaceRoot}/configuration/squawk.toml",
          "shared-globals",
          {
            "externalDependencies": ["squawk-cli"]
          }
        ],
        "options": {
          "command": "squawk --config configuration/squawk.toml --exclude prefer-robust-stmts,ban-drop-table,require-concurrent-index-deletion,require-concurrent-index-creation,ban-char-field,prefer-bigint-over-smallint,constraint-missing-not-valid,adding-foreign-key-constraint,ban-drop-column,adding-required-field '{projectRoot}/**/*.sql'",
          "cwd": "{workspaceRoot}"
        }
      }
    ],
    "start": [
      {
        "cache": false,
        "description": "Start a Nest Commander application",
        "executor": "nx:run-commands",
        "filter": {
          "projects": ["tag:framework:nest-commander"]
        },
        "options": {
          "command": "node --import @swc-node/register/esm-register src/main.ts {projectName}",
          "cwd": "{projectRoot}"
        }
      }
    ],
    "stylelint": [
      {
        "cache": true,
        "configurations": {
          "check": {
            "command": "stylelint --allow-empty-input --config ../../configuration/stylelint.config.cjs 'src/**/*.css'"
          },
          "write": {
            "command": "stylelint --allow-empty-input --fix --config ../../configuration/stylelint.config.cjs 'src/**/*.css'"
          }
        },
        "defaultConfiguration": "check",
        "executor": "nx:run-commands",
        "filter": {
          "projects": ["tag:language:typescript"]
        },
        "inputs": [
          "{projectRoot}/src/**/*.css",
          "{workspaceRoot}/configuration/stylelint.config.cjs",
          "shared-globals",
          {
            "externalDependencies": [
              "stylelint",
              "stylelint-config-standard",
              "stylelint-config-tailwindcss"
            ]
          }
        ],
        "options": {
          "command": "stylelint --allow-empty-input --config ../../configuration/stylelint.config.cjs 'src/**/*.css'",
          "cwd": "{projectRoot}"
        }
      }
    ],
    "test-coverage": {
      "cache": false,
      "configurations": {
        "coverage": {},
        "integration": {},
        "unit": {}
      },
      "defaultConfiguration": "coverage",
      "dependsOn": ["pytest", "vitest"],
      "description": "Dynamic code analysis: the tests, which execute the source. An nx:noop aggregator. The configuration propagates down dependsOn, so test-coverage:coverage reaches test:coverage.",
      "executor": "nx:noop"
    },
    "ty": [
      {
        "cache": true,
        "executor": "nx:run-commands",
        "filter": {
          "projects": ["tag:language:python"]
        },
        "inputs": [
          "{workspaceRoot}/pyproject.toml",
          "{workspaceRoot}/uv.lock",
          "python-source"
        ],
        "options": {
          "command": "uv run ty check src/",
          "cwd": "{projectRoot}"
        }
      }
    ],
    "type-coverage": [
      {
        "cache": true,
        "executor": "nx:run-commands",
        "filter": {
          "projects": ["tag:language:typescript"]
        },
        "inputs": [
          "{projectRoot}/**/*.ts",
          "{projectRoot}/**/*.tsx",
          "{projectRoot}/package.json",
          "{projectRoot}/tsconfig.json",
          "shared-globals",
          {
            "externalDependencies": ["type-coverage", "typescript"]
          }
        ],
        "options": {
          "command": "type-coverage --detail > type-coverage-report.txt 2>&1 || (cat type-coverage-report.txt && exit 1)",
          "cwd": "{projectRoot}"
        },
        "outputs": ["{projectRoot}/type-coverage-report.txt"]
      }
    ],
    "typecheck": [
      {
        "cache": false,
        "dependsOn": ["pyright", "ty"],
        "executor": "nx:noop",
        "filter": {
          "projects": ["tag:language:python"]
        }
      },
      {
        "cache": true,
        "executor": "nx:run-commands",
        "filter": {
          "projects": ["tag:language:typescript"]
        },
        "inputs": [
          "^production",
          "{workspaceRoot}/pnpm-workspace.yaml",
          "typescript-files"
        ],
        "options": {
          "command": "node \"$NX_WORKSPACE_ROOT/node_modules/typescript-7/bin/tsc\" --noEmit",
          "cwd": "{projectRoot}"
        },
        "outputs": []
      }
    ],
    "vitest": {
      "configurations": {
        "coverage": {
          "command": "pnpm exec vitest run --coverage --coverage.provider=v8"
        },
        "end-to-end": {
          "command": "pnpm exec vitest run end-to-end.test.ts"
        },
        "integration": {
          "command": "pnpm exec vitest run integration.test.ts"
        },
        "unit": {
          "command": "pnpm exec vitest run unit.test.ts"
        },
        "watch": {
          "command": "pnpm exec vitest"
        }
      },
      "defaultConfiguration": "coverage",
      "description": "Extra configurations layered onto the vitest target that @nx/vitest infers. The plugin supplies the command, inputs, and outputs. Coverage is the default so that a bare `test-coverage` run still enforces the thresholds \u2014 Nx only propagates a configuration down `dependsOn` when it is named explicitly."
    },
    "vulture": [
      {
        "cache": true,
        "configurations": {
          "check": {},
          "write": {}
        },
        "defaultConfiguration": "check",
        "executor": "nx:run-commands",
        "filter": {
          "projects": ["tag:language:python"]
        },
        "inputs": [
          "{projectRoot}/.vulture_whitelist.py",
          "{workspaceRoot}/pyproject.toml",
          "{workspaceRoot}/uv.lock",
          "python-source"
        ],
        "options": {
          "command": "uv run python -m vulture src/ .vulture_whitelist.py --min-confidence 80",
          "cwd": "{projectRoot}"
        }
      }
    ],
    "yaml-lint": [
      {
        "cache": true,
        "executor": "nx:run-commands",
        "filter": {
          "projects": ["tag:language:python", "tag:language:typescript"]
        },
        "inputs": [
          "{projectRoot}/**/*.{yaml,yml}",
          "{workspaceRoot}/configuration/yamllint.yaml",
          "{workspaceRoot}/pyproject.toml",
          "{workspaceRoot}/uv.lock",
          "shared-globals"
        ],
        "options": {
          "command": "uv run yamllint -c configuration/yamllint.yaml '{projectRoot}'",
          "cwd": "{workspaceRoot}"
        }
      }
    ]
  },
  "tui": {
    "enabled": false
  },
  "workspaceLayout": {
    "appsDir": "applications",
    "libsDir": "packages"
  }
}
