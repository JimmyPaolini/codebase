{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "codependix-examples",
  "projectType": "library",
  "sourceRoot": "packages/codependix-examples",
  "tags": [
    "framework:nest-commander",
    "framework:nestjs",
    "generator:nestjs-command-project",
    "language:typescript",
    "name:codependix-examples",
    "type:package"
  ],
  "targets": {
    "codometer": {},
    "dependency-cruiser": {},
    "examples": {
      "cache": true,
      "configurations": {
        "check": {
          "command": "node --import @swc-node/register/esm-register src/main.ts examples --check"
        },
        "write": {
          "command": "node --import @swc-node/register/esm-register src/main.ts examples --write"
        }
      },
      "defaultConfiguration": "check",
      "description": "Render every codependix example and compare it against the committed output under `output/`, or rewrite it. `check` is what keeps the guides honest: a resolver or scanner change that silently reverses one of the documented behaviors fails here rather than leaving a guide quoting a diagram the tool no longer renders. Unlike `codebase:codependix`, both configurations are safe on a branch — every example is built from fixtures this package owns, so nothing here moves when the workspace around it does.",
      "executor": "nx:run-commands",
      "inputs": ["{projectRoot}/fixtures/**", "default"],
      "options": {
        "cwd": "{projectRoot}"
      },
      "outputs": ["{projectRoot}/output"]
    },
    "knip": {},
    "lint-codebase": {},
    "markdown-lint": {},
    "oxfmt": {},
    "oxlint": {},
    "prettier": {},
    "spell-check": {},
    "test-coverage": {},
    "type-coverage": {},
    "typecheck": {},
    "yaml-lint": {}
  }
}
