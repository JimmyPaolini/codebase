{
  "dependencies": {
    "@golevelup/ts-vitest": "catalog:",
    "@jimmypaolini/conformetry-configuration": "workspace:*",
    "@jimmypaolini/conformetry-core": "workspace:*",
    "@jimmypaolini/conformetry-generation": "workspace:*",
    "@jimmypaolini/conformetry-json": "workspace:*",
    "@jimmypaolini/conformetry-jupyter": "workspace:*",
    "@jimmypaolini/conformetry-markdown": "workspace:*",
    "@jimmypaolini/conformetry-python": "workspace:*",
    "@jimmypaolini/conformetry-text": "workspace:*",
    "@jimmypaolini/conformetry-typescript": "workspace:*",
    "@jimmypaolini/conformetry-validation": "workspace:*",
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@nx/devkit": "catalog:",
    "@swc-node/register": "catalog:",
    "pino": "catalog:",
    "reflect-metadata": "catalog:",
    "tslib": "catalog:"
  },
  "devDependencies": {
    "@nestjs/testing": "catalog:",
    "@nx/eslint-plugin": "catalog:",
    "@swc/helpers": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "executors": "./executors.json",
  "exports": {
    ".": {
      "default": "./src/index.cjs",
      "import": "./src/index.cjs",
      "require": "./src/index.cjs",
      "types": "./src/index.ts"
    },
    "./executors.json": "./executors.json",
    "./generators.json": "./generators.json",
    "./package.json": "./package.json",
    "./src/executors/*": "./src/executors/*",
    "./src/generators/*": "./src/generators/*"
  },
  "generators": "./generators.json",
  "main": "src/index.ts",
  "name": "@jimmypaolini/conformetry-nx",
  "private": true,
  "nx": {
    "executors": "./executors.json",
    "generators": "./generators.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "type": "module",
  "typeCoverage": {
    "atLeast": 100,
    "strict": true
  },
  "types": "src/index.ts",
  "version": "0.0.1"
}
