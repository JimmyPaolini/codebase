{
  "dependencies": {
    "@golevelup/ts-vitest": "catalog:",
    "@jimmypaolini/conformetry-validation": "workspace:*",
    "@nestjs/common": "catalog:",
    "@nestjs/config": "catalog:",
    "@nestjs/core": "catalog:",
    "pino": "catalog:",
    "reflect-metadata": "catalog:",
    "tslib": "catalog:",
    "typescript": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@nestjs/testing": "catalog:",
    "@nx/eslint-plugin": "catalog:",
