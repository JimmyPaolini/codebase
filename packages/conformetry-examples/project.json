      "executor": "nx:run-commands",
      "options": {
        "command": "node --import @swc-node/register/esm-register packages/conformetry-cli/src/main.ts validate --config packages/conformetry-examples/examples/structural-not-textual/conformetry.config.ts",
        "cwd": "{workspaceRoot}",
        "env": {
