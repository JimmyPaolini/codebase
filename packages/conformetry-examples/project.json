      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "node --import @swc-node/register/esm-register packages/conformetry-cli/src/main.ts instances --config packages/conformetry-examples/examples/two-directions/conformetry.config.ts",
          "node --import @swc-node/register/esm-register packages/conformetry-cli/src/main.ts templates --config packages/conformetry-examples/examples/two-directions/conformetry.config.ts --instances packages/conformetry-examples/examples/two-directions/instances/alpha"
        ],
        "cwd": "{workspaceRoot}",
        "env": {
          "SWC_NODE_PROJECT": "packages/conformetry-cli/tsconfig.json"
        },
        "parallel": false
      }
    },
    "type-coverage": {},
    "typecheck": {},
    "yaml-lint": {}
