      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "node --import @swc-node/register/esm-register packages/conformetry-cli/src/main.ts instances --config packages/conformetry-examples/examples/nx-host/conformetry.config.ts",
          "node --import @swc-node/register/esm-register packages/conformetry-cli/src/main.ts validate --config packages/conformetry-examples/examples/nx-host/conformetry.config.ts"
        ],
        "cwd": "{workspaceRoot}",
        "env": {
          "SWC_NODE_PROJECT": "packages/conformetry-cli/tsconfig.json"
        },
        "parallel": false
      }
    },
    "oxfmt": {},
    "prettier": {},
    "scoring-thresholds": {
      "cache": false,
      "description": "Validate two instance groups held to different thresholds. Exits zero, and still prints the lenient group's findings",
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "node --import @swc-node/register/esm-register packages/conformetry-cli/src/main.ts validate --config packages/conformetry-examples/examples/scoring-thresholds/conformetry.config.ts",
          "node --import @swc-node/register/esm-register packages/conformetry-cli/src/main.ts validate --config packages/conformetry-examples/examples/scoring-thresholds/conformetry.config.ts --threshold 0.5"
        ],
        "cwd": "{workspaceRoot}",
        "env": {
          "SWC_NODE_PROJECT": "packages/conformetry-cli/tsconfig.json"
        },
        "parallel": false
      }
    },
    "spell-check": {},
    "structural-not-textual": {
      "cache": false,
