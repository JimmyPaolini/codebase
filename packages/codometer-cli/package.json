{
  "bin": {
    "codometer": "./src/main.js"
  },
  "dependencies": {
    "@codebase/logger": "workspace:*",
    "@codometer/changes": "workspace:*",
    "@codometer/configuration": "workspace:*",
    "@codometer/customization": "workspace:*",
    "@codometer/discovery": "workspace:*",
    "@codometer/languages": "workspace:*",
    "@codometer/output": "workspace:*",
    "@codometer/size": "workspace:*",
    "@nestjs/common": "catalog:",
    "@nestjs/config": "catalog:",
    "@nestjs/core": "catalog:",
    "nest-commander": "catalog:",
    "reflect-metadata": "catalog:",
    "tslib": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@golevelup/ts-vitest": "catalog:",
    "@nestjs/testing": "catalog:",
    "@nx/eslint-plugin": "catalog:",
    "@swc-node/register": "catalog:",
    "@swc/core": "catalog:",
    "@swc/helpers": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "main": "src/index.ts",
  "name": "@codometer/cli",
  "private": true,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "type": "module",
  "typeCoverage": {
    "atLeast": 100,
    "strict": true
  },
  "types": "src/index.ts",
  "version": "0.0.1"
}
