{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "lexico-components",
  "projectType": "library",
  "sourceRoot": "packages/lexico-components/src",
  "tags": [
    "domain:lexico",
    "framework:react",
    "language:typescript",
    "type:package"
  ],
  "targets": {
    "build": {
      "executor": "@nx/vite:build",
      "options": {
        "outputPath": "dist/packages/lexico-components"
      },
      "outputs": ["{options.outputPath}"]
    },
    "bundlesize": {},
    "dependency-cruiser": {},
    "knip": {},
    "lint-codebase": {},
    "make-projects": {},
    "markdown-lint": {},
    "oxfmt": {},
    "oxlint": {},
    "prettier": {},
    "spell-check": {},
    "stylelint": {},
    "type-coverage": {
      "options": {
        "command": "type-coverage --detail --ignore-files \"src/components/**\" \"src/hooks/**\" \"src/lib/**\" > type-coverage-report.txt 2>&1 || (cat type-coverage-report.txt && exit 1)"
      }
    },
    "typecheck": {},
    "yaml-lint": {}
  }
}
