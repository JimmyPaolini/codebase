{
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "name": "codependix-cli",
  "projectType": "library",
  "sourceRoot": "packages/ic-suite/codependix/codependix-cli",
  "tags": [
    "framework:nest-commander",
    "framework:nestjs",
    "generator:nestjs-command-project",
    "language:typescript",
    "layer:cli",
    "name:codependix-cli",
    "type:package"
  ],
  "targets": {
    "build": {
      "executor": "@nx/vite:build",
      "options": {
        "configFile": "packages/ic-suite/codependix/codependix-cli/vite.config.ts",
        "generatePackageJson": false,
        "outputPath": "packages/ic-suite/codependix/codependix-cli/dist"
      },
      "outputs": ["{options.outputPath}"]
    },
    "build-projects": {},
    "codometer": {},
    "dependency-cruiser": {},
    "deprecate-code": {},
    "format-code": {},
    "guard-code": {},
    "knip": {},
    "lint-code": {},
    "markdown-lint": {},
    "oxfmt": {},
    "oxlint": {},
    "pack": {
      "cache": true,
      "dependsOn": ["build"],
      "description": "Pack this package into a tarball in dist/tarballs using pnpm pack.",
      "executor": "nx:run-commands",
      "inputs": ["^production", "dependency-versions", "production"],
      "options": {
        "command": "pnpm pack --pack-destination ../../../../dist/tarballs",
        "cwd": "{projectRoot}"
      },
      "outputs": ["{workspaceRoot}/dist/tarballs/{projectName}-*.tgz"]
    },
    "prettier": {},
    "spell-check": {},
    "start": {
      "cache": false,
      "executor": "nx:run-commands",
      "options": {
        "command": "node --import @swc-node/register/esm-register packages/ic-suite/codependix/codependix-cli/src/main.ts",
        "cwd": "{workspaceRoot}",
        "env": {
          "SWC_NODE_PROJECT": "packages/ic-suite/codependix/codependix-cli/tsconfig.json"
        }
      }
    },
    "test-code": {},
    "type-coverage": {},
    "typecheck": {},
    "typecheck-code": {},
    "yaml-lint": {}
  }
}
