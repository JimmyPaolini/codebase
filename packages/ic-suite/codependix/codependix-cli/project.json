{
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "name": "codependix-cli",
  "projectType": "library",
  "sourceRoot": "packages/ic-suite/codependix/codependix-cli",
  "tags": [
    "framework:nest-commander",
    "framework:nestjs",
    "generator:nestjs-command-project",
    "language:typescript",
    "layer:cli",
    "name:codependix-cli",
    "type:package"
  ],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "options": {
        "assets": [
          {
            "glob": "README.md",
            "input": "packages/ic-suite/codependix/codependix-cli",
            "output": "."
          }
        ],
        "generatePackageJson": false,
        "main": "packages/ic-suite/codependix/codependix-cli/src/main.ts",
        "outputPath": "packages/ic-suite/codependix/codependix-cli/dist",
        "tsConfig": "packages/ic-suite/codependix/codependix-cli/tsconfig.build.json"
      },
      "outputs": ["{options.outputPath}"]
    },
    "codometer": {},
    "dependency-cruiser": {},
    "form-codebase": {},
    "gate-codebase": {},
    "knip": {},
    "lint-codebase": {},
    "make-projects": {},
    "markdown-lint": {},
    "oxfmt": {},
    "oxlint": {},
    "prettier": {},
    "scrub-codebase": {},
    "spell-check": {},
    "start": {
      "cache": false,
      "executor": "nx:run-commands",
      "options": {
        "command": "node --import @swc-node/register/esm-register packages/ic-suite/codependix/codependix-cli/src/main.ts",
        "cwd": "{workspaceRoot}",
        "env": {
          "SWC_NODE_PROJECT": "packages/ic-suite/codependix/codependix-cli/tsconfig.json"
        }
      }
    },
    "test-coverage": {},
    "type-codebase": {},
    "type-coverage": {},
    "typecheck": {},
    "yaml-lint": {}
  }
}
