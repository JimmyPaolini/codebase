{
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "name": "codometer-agents",
  "projectType": "library",
  "sourceRoot": "packages/ic-suite/codometer/codometer-agents",
  "tags": ["language:typescript", "name:codometer-agents", "type:package"],
  "targets": {
    "build-projects": {},
    "codometer": {},
    "deprecate-code": {},
    "format-code": {},
    "guard-code": {},
    "knip": {},
    "lint-code": {},
    "markdown-lint": {},
    "oxfmt": {},
    "pack": {
      "cache": true,
      "dependsOn": ["build"],
      "description": "Pack this package into a tarball in dist/tarballs using pnpm pack.",
      "executor": "nx:run-commands",
      "inputs": ["^production", "dependency-versions", "production"],
      "options": {
        "command": "pnpm pack --pack-destination ../../../../dist/tarballs",
        "cwd": "{projectRoot}"
      },
      "outputs": ["{workspaceRoot}/dist/tarballs/{projectName}-*.tgz"]
    },
    "prettier": {},
    "spell-check": {},
    "test-code": {},
    "type-coverage": {},
    "typecheck": {},
    "typecheck-code": {},
    "yaml-lint": {}
  }
}
