{
  "bin": {
    "conformetry": "./dist/src/main.js"
  },
  "dependencies": {
    "@codebase/logger": "workspace:*",
    "@conformetry/configuration": "workspace:*",
    "@conformetry/core": "workspace:*",
    "@conformetry/generation": "workspace:*",
    "@conformetry/validation": "workspace:*",
    "@nestjs/common": "catalog:",
    "@nestjs/config": "catalog:",
    "@nestjs/core": "catalog:",
    "nest-commander": "catalog:",
    "reflect-metadata": "catalog:",
    "tslib": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@golevelup/ts-vitest": "catalog:",
    "@nestjs/testing": "catalog:",
    "@nx/eslint-plugin": "catalog:",
    "@swc-node/register": "catalog:",
    "@swc/core": "catalog:",
    "@swc/helpers": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "main": "src/index.ts",
  "name": "@conformetry/cli",
  "private": true,
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "default": "./dist/src/index.js",
        "types": "./dist/src/index.d.ts"
      },
      "./package.json": "./package.json"
    },
    "main": "./dist/src/index.js",
    "registry": "https://registry.npmjs.org",
    "types": "./dist/src/index.d.ts"
  },
  "type": "module",
  "typeCoverage": {
    "atLeast": 100,
    "strict": true
  },
  "types": "src/index.ts",
  "version": "0.0.1"
}
