{
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "name": "conformetry-cli",
  "projectType": "library",
  "sourceRoot": "packages/ic-suite/conformetry/conformetry-cli",
  "tags": [
    "framework:nest-commander",
    "framework:nestjs",
    "generator:nestjs-command-project",
    "language:typescript",
    "layer:cli",
    "name:conformetry",
    "type:package"
  ],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "options": {
        "assets": [
          {
            "glob": "README.md",
            "input": "packages/ic-suite/conformetry/conformetry-cli",
            "output": "."
          }
        ],
        "generatePackageJson": false,
        "main": "packages/ic-suite/conformetry/conformetry-cli/src/main.ts",
        "outputPath": "packages/ic-suite/conformetry/conformetry-cli/dist",
        "tsConfig": "packages/ic-suite/conformetry/conformetry-cli/tsconfig.build.json"
      },
      "outputs": ["{options.outputPath}"]
    },
    "build-projects": {},
    "codometer": {},
    "dependency-cruiser": {},
    "deprecate-code": {},
    "format-code": {},
    "guard-code": {},
    "knip": {},
    "lint-code": {},
    "markdown-lint": {},
    "oxfmt": {},
    "oxlint": {},
    "pack": {
      "cache": true,
      "dependsOn": ["build"],
      "description": "Pack this package into a tarball in dist/tarballs using pnpm pack.",
      "executor": "nx:run-commands",
      "inputs": ["^production", "dependency-versions", "production"],
      "options": {
        "command": "pnpm pack --pack-destination ../../../../dist/tarballs",
        "cwd": "{projectRoot}"
      },
      "outputs": ["{workspaceRoot}/dist/tarballs/{projectName}-*.tgz"]
    },
    "prettier": {},
    "spell-check": {},
    "start": {
      "cache": false,
      "executor": "nx:run-commands",
      "options": {
        "command": "node --import @swc-node/register/esm-register packages/ic-suite/conformetry/conformetry-cli/src/main.ts",
        "cwd": "{workspaceRoot}",
        "env": {
          "SWC_NODE_PROJECT": "packages/ic-suite/conformetry/conformetry-cli/tsconfig.json"
        }
      }
    },
    "test-code": {},
    "type-coverage": {},
    "typecheck": {},
    "typecheck-code": {},
    "yaml-lint": {}
  }
}
