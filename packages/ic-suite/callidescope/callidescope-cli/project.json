{
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "name": "callidescope-cli",
  "projectType": "library",
  "sourceRoot": "packages/ic-suite/callidescope/callidescope-cli",
  "tags": [
    "framework:nest-commander",
    "framework:nestjs",
    "generator:nestjs-command-project",
    "language:typescript",
    "layer:cli",
    "name:callidescope-cli",
    "type:package"
  ],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "options": {
        "assets": [
          {
            "glob": "README.md",
            "input": "packages/ic-suite/callidescope/callidescope-cli",
            "output": "."
          }
        ],
        "generatePackageJson": false,
        "main": "packages/ic-suite/callidescope/callidescope-cli/src/main.ts",
        "outputPath": "packages/ic-suite/callidescope/callidescope-cli/dist",
        "tsConfig": "packages/ic-suite/callidescope/callidescope-cli/tsconfig.build.json"
      },
      "outputs": ["{options.outputPath}"]
    },
    "build-projects": {},
    "codometer": {},
    "dependency-cruiser": {},
    "deprecate-code": {},
    "format-code": {},
    "guard-code": {},
    "knip": {},
    "lint-code": {},
    "markdown-lint": {},
    "oxfmt": {},
    "oxlint": {},
    "prettier": {},
    "spell-check": {},
    "start": {
      "cache": false,
      "executor": "nx:run-commands",
      "options": {
        "command": "node --import @swc-node/register/esm-register packages/ic-suite/callidescope/callidescope-cli/src/main.ts",
        "cwd": "{workspaceRoot}",
        "env": {
          "SWC_NODE_PROJECT": "packages/ic-suite/callidescope/callidescope-cli/tsconfig.json"
        }
      }
    },
    "test-code": {},
    "type-coverage": {},
    "typecheck": {},
    "typecheck-code": {},
    "yaml-lint": {}
  }
}
