{
  "dependencies": {
    "@callidescope/cli": "workspace:*",
    "@callidescope/configuration": "workspace:*",
    "@callidescope/core": "workspace:*",
    "@callidescope/graph": "workspace:*",
    "@callidescope/output": "workspace:*",
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@nx/devkit": "catalog:",
    "pino": "catalog:",
    "pino-pretty": "catalog:",
    "reflect-metadata": "catalog:"
  },
  "devDependencies": {
    "@codebase/logger": "workspace:*",
    "@golevelup/ts-vitest": "catalog:",
    "@nestjs/testing": "catalog:",
    "@nx/eslint-plugin": "catalog:",
    "@swc/helpers": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "executors": "./executors.json",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./executors.json": "./executors.json",
    "./package.json": "./package.json",
    "./src/executors/*": "./src/executors/*"
  },
  "files": [
    "dist",
    "executors.json",
    "LICENSE",
    "README.md"
  ],
  "main": "src/index.ts",
  "name": "@callidescope/nx",
  "nx": {
    "executors": "./executors.json"
  },
  "private": true,
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/src/index.d.ts",
        "default": "./dist/src/index.js"
      },
      "./executors.json": "./executors.json",
      "./package.json": "./package.json",
      "./src/executors/*": "./dist/src/executors/*.js"
    },
    "main": "./dist/src/index.js",
    "registry": "https://registry.npmjs.org",
    "types": "./dist/src/index.d.ts"
  },
  "type": "module",
  "typeCoverage": {
    "atLeast": 100,
    "strict": true
  },
  "types": "src/index.ts",
  "version": "0.0.1"
}
