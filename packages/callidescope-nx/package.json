{
  "dependencies": {
    "@callidescope/cli": "workspace:*",
    "@callidescope/configuration": "workspace:*",
    "@callidescope/output": "workspace:*",
    "@codebase/logger": "workspace:*",
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@nx/devkit": "catalog:",
    "@swc-node/register": "catalog:",
    "reflect-metadata": "catalog:",
    "tslib": "catalog:"
  },
  "devDependencies": {
    "@golevelup/ts-vitest": "catalog:",
    "@nestjs/testing": "catalog:",
    "@nx/eslint-plugin": "catalog:",
    "@swc/core": "catalog:",
    "@swc/helpers": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "executors": "./executors.json",
  "exports": {
    ".": {
      "default": "./src/index.cjs",
      "import": "./src/index.cjs",
      "require": "./src/index.cjs",
      "types": "./src/index.ts"
    },
    "./executors.json": "./executors.json",
    "./package.json": "./package.json",
    "./src/executors/*": "./src/executors/*"
  },
  "main": "src/index.ts",
  "name": "@callidescope/nx",
  "nx": {
    "executors": "./executors.json"
  },
  "private": true,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "type": "module",
  "typeCoverage": {
    "atLeast": 100,
    "strict": true
  },
  "types": "src/index.ts",
  "version": "0.0.1"
}
