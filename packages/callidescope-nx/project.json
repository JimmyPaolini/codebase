{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "callidescope-nx",
  "projectType": "library",
  "sourceRoot": "packages/callidescope-nx",
  "tags": [
    "framework:nestjs",
    "generator:nestjs-service-project",
    "language:typescript",
    "name:callidescope-nx",
    "type:package"
  ],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "options": {
        "assets": [
          {
            "glob": "README.md",
            "input": "packages/callidescope-nx",
            "output": "."
          },
          {
            "glob": "executors.json",
            "input": "packages/callidescope-nx",
            "output": "."
          },
          {
            "glob": "src/executors/**/schema.json",
            "input": "packages/callidescope-nx",
            "output": "."
          },
          {
            "glob": "src/index.cjs",
            "input": "packages/callidescope-nx",
            "output": "."
          }
        ],
        "main": "packages/callidescope-nx/src/index.ts",
        "outputPath": "dist/packages/callidescope-nx",
        "tsConfig": "packages/callidescope-nx/tsconfig.build.json"
      },
      "outputs": ["{options.outputPath}"]
    },
    "codometer": {},
    "dependency-cruiser": {},
    "knip": {},
    "lint-codebase": {},
    "make-projects": {},
    "markdown-lint": {},
    "oxfmt": {},
    "oxlint": {},
    "prettier": {},
    "spell-check": {},
    "test-coverage": {},
    "type-coverage": {},
    "typecheck": {},
    "yaml-lint": {}
  }
}
