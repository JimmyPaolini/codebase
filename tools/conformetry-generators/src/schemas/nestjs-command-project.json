{
  "$schema": "http://json-schema.org/schema",
  "description": "Generate a NestJS command-line application using nest-commander",
  "properties": {
    "name": {
      "type": "string",
      "description": "Project name (kebab-case)"
    },
    "type": {
      "type": "string",
      "description": "Project type (application, package, or tools)"
    }
  },
  "required": [
    "name",
    "type"
  ],
  "title": "nestjs-command-project",
  "type": "object"
}
