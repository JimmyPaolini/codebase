{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "synchronization",
  "projectType": "application",
  "sourceRoot": "tools/synchronization",
  "tags": [
    "framework:nest-commander",
    "framework:nestjs",
    "generator:nestjs-command-project",
    "language:typescript",
    "type:package"
  ],
  "targets": {
    "codometer": {},
    "dependency-cruiser": {},
    "knip": {},
    "lint-codebase": {},
    "markdown-lint": {},
    "oxfmt": {},
    "oxlint": {},
    "prettier": {},
    "repl": {},
    "spell-check": {},
    "start": {
      "cache": false,
      "configurations": {
        "check": {
          "command": "NODE_OPTIONS='' node --import @swc-node/register/esm-register tools/synchronization/src/main.ts synchronization check"
        },
        "conformetry-generators-check": {
          "command": "NODE_OPTIONS='' node --import @swc-node/register/esm-register tools/synchronization/src/main.ts conformetry-generators check"
        },
        "conformetry-generators-write": {
          "command": "NODE_OPTIONS='' node --import @swc-node/register/esm-register tools/synchronization/src/main.ts conformetry-generators write"
        },
        "conventional-config-check": {
          "command": "NODE_OPTIONS='' node --import @swc-node/register/esm-register tools/synchronization/src/main.ts conventional-config check"
        },
        "conventional-config-write": {
          "command": "NODE_OPTIONS='' node --import @swc-node/register/esm-register tools/synchronization/src/main.ts conventional-config write"
        },
        "devcontainer-configuration-check": {
          "command": "NODE_OPTIONS='' node --import @swc-node/register/esm-register tools/synchronization/src/main.ts devcontainer-configuration check"
        },
        "devcontainer-configuration-write": {
          "command": "NODE_OPTIONS='' node --import @swc-node/register/esm-register tools/synchronization/src/main.ts devcontainer-configuration write"
        },
        "nestjs-module-graphs-check": {
          "command": "NODE_OPTIONS='' node --import @swc-node/register/esm-register tools/synchronization/src/main.ts nestjs-module-graphs check"
        },
        "nestjs-module-graphs-write": {
          "command": "NODE_OPTIONS='' node --import @swc-node/register/esm-register tools/synchronization/src/main.ts nestjs-module-graphs write"
        },
        "nx-project-graphs-check": {
          "command": "NODE_OPTIONS='' node --import @swc-node/register/esm-register tools/synchronization/src/main.ts nx-project-graphs check"
        },
        "nx-project-graphs-write": {
          "command": "NODE_OPTIONS='' node --import @swc-node/register/esm-register tools/synchronization/src/main.ts nx-project-graphs write"
        },
        "pull-request-template-check": {
          "command": "NODE_OPTIONS='' node --import @swc-node/register/esm-register tools/synchronization/src/main.ts pull-request-template check"
        },
        "pull-request-template-write": {
          "command": "NODE_OPTIONS='' node --import @swc-node/register/esm-register tools/synchronization/src/main.ts pull-request-template write"
        },
        "skill-exclusions-check": {
          "command": "NODE_OPTIONS='' node --import @swc-node/register/esm-register tools/synchronization/src/main.ts skill-exclusions check"
        },
        "skill-exclusions-write": {
          "command": "NODE_OPTIONS='' node --import @swc-node/register/esm-register tools/synchronization/src/main.ts skill-exclusions write"
        },
        "write": {
          "command": "NODE_OPTIONS='' node --import @swc-node/register/esm-register tools/synchronization/src/main.ts synchronization write"
        }
      },
      "defaultConfiguration": "check",
      "description": "Run every synchronization command (default), or one of them via a named configuration.",
      "executor": "nx:run-commands",
      "options": {
        "command": "NODE_OPTIONS='' node --import @swc-node/register/esm-register tools/synchronization/src/main.ts synchronization check",
        "cwd": "{workspaceRoot}"
      }
    },
    "synchronize": {
      "cache": true,
      "configurations": {
        "check": {
          "command": "NODE_OPTIONS='' node --import @swc-node/register/esm-register tools/synchronization/src/main.ts synchronization check"
        },
        "write": {
          "command": "NODE_OPTIONS='' node --import @swc-node/register/esm-register tools/synchronization/src/main.ts synchronization write"
        }
      },
      "defaultConfiguration": "check",
      "description": "Run every synchronization command in one process. This is what lint-codebase depends on \u2014 it cannot depend on `start`, because other projects use that name to launch an application. `start` (default configuration) runs the same thing for interactive use.",
      "executor": "nx:run-commands",
      "inputs": [
        "{projectRoot}/**/*.ts",
        "{workspaceRoot}/.agents/skills/**",
        "{workspaceRoot}/.devcontainer/cloud/devcontainer.json",
        "{workspaceRoot}/.devcontainer/local/devcontainer.json",
        "{workspaceRoot}/.gitattributes",
        "{workspaceRoot}/.github/agents/**",
        "{workspaceRoot}/.github/ISSUE_TEMPLATE/**",
        "{workspaceRoot}/.github/PULL_REQUEST_TEMPLATE.md",
        "{workspaceRoot}/.vscode/settings.json",
        "{workspaceRoot}/AGENTS.md",
        "{workspaceRoot}/applications/*/AGENTS.md",
        "{workspaceRoot}/applications/*/project.json",
        "{workspaceRoot}/applications/*/README.md",
        "{workspaceRoot}/applications/*/src/**/*.module.ts",
        "{workspaceRoot}/configuration/.codometerignore",
        "{workspaceRoot}/configuration/.prettierignore",
        "{workspaceRoot}/configuration/conformetry.config.ts",
        "{workspaceRoot}/configuration/conventional.config.cjs",
        "{workspaceRoot}/nx.json",
        "{workspaceRoot}/packages/*/AGENTS.md",
        "{workspaceRoot}/packages/*/project.json",
        "{workspaceRoot}/packages/*/README.md",
        "{workspaceRoot}/packages/*/src/**/*.module.ts",
        "{workspaceRoot}/release.config.cjs",
        "{workspaceRoot}/skills-lock.json",
        "{workspaceRoot}/tools/*/AGENTS.md",
        "{workspaceRoot}/tools/*/project.json",
        "{workspaceRoot}/tools/*/README.md",
        "{workspaceRoot}/tools/*/src/**/*.module.ts",
        "shared-globals"
      ],
      "options": {
        "cwd": "{workspaceRoot}"
      }
    },
    "test-coverage": {},
    "type-coverage": {},
    "typecheck": {},
    "yaml-lint": {}
  }
}
