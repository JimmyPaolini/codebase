{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "reporting",
  "projectType": "application",
  "sourceRoot": "tools/reporting",
  "tags": [
    "framework:nest-commander",
    "framework:nestjs",
    "generator:nestjs-command-project",
    "language:typescript",
    "type:package"
  ],
  "targets": {
    "codometer": {},
    "dependency-cruiser": {},
    "knip": {},
    "lint-codebase": {},
    "markdown-lint": {},
    "oxfmt": {},
    "oxlint": {},
    "prettier": {},
    "repl": {},
    "spell-check": {},
    "start": {
      "cache": false,
      "configurations": {
        "bundles": {
          "command": "NODE_OPTIONS='' node --import @swc-node/register/esm-register tools/reporting/src/main.ts bundles"
        }
      },
      "description": "Render every internal report (default), or one of them via a named configuration. It carries the `start` name every other nest-commander project uses to launch its application, rather than a `report` name of its own: unlike `synchronization`, which needs a second `synchronize` target because its gate is cacheable and wired into `lint-codebase`, this target is the only way this application runs, so nothing competes for the conventional name.",
      "executor": "nx:run-commands",
      "options": {
        "command": "NODE_OPTIONS='' node --import @swc-node/register/esm-register tools/reporting/src/main.ts reporting",
        "cwd": "{workspaceRoot}"
      }
    },
    "test-coverage": {},
    "type-coverage": {},
    "typecheck": {},
    "yaml-lint": {}
  }
}
