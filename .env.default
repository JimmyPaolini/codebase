# 🌱 Environment
GH_TOKEN=""
GITHUB_TOKEN=""
MONOREPO_ENVIRONMENT="local"
TF_VAR_linode_kubernetes_engine_cluster_id=""
TF_VAR_linode_token=""

# 🐳 Service URLs (defaults for local development; devcontainer overrides via remoteEnv)
OLLAMA_HOST="http://localhost:11434"
SEARXNG_HOST="http://localhost:8889"

# 🐘 PostgreSQL
POSTGRES_DB="postgres"
POSTGRES_HOST="localhost"
POSTGRES_PASSWORD="postgres"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"

# 📚 OpenWiki
GEMINI_API_KEY="$"
OPENWIKI_MODEL="gemini-3.1-pro"
OPENWIKI_PROVIDER="gemini"
OPENWIKI_TELEMETRY_DISABLED="true"
