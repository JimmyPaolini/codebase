{
  "compilerOptions": {
    // `configuration/lint-staged.config.ts` is loaded by Node's native
    // TypeScript stripping during pre-commit, which resolves imports exactly
    // as written and so needs explicit `.ts` extensions. Safe here because
    // this project only typechecks.
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "paths": {
      "codebase/configuration/*": ["./configuration/*"],
      "eslint-plugin-better-max-params": [
        "./configuration/types/eslint-plugin-better-max-params/index.d.ts"
      ]
    },
    "skipLibCheck": true
  },
  "exclude": [
    "applications",
    "configuration/conformetry-templates",
    "dist",
    "node_modules",
    "packages",
    "tmp",
    "tools"
  ],
  "extends": "./configuration/tsconfig.json",
  "include": [
    "*.ts",
    ".devcontainer/scripts/**/*.ts",
    "configuration/**/*.ts",
    "scripts/**/*.ts"
  ]
}
