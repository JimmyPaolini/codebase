{
  "compilerOptions": {
    // Retained after `configuration/lint-staged.config.ts` was removed: that
    // file was loaded by Node's native TypeScript stripping during pre-commit,
    // which resolves imports exactly as written and so needed explicit `.ts`
    // extensions. Nothing in this project uses them today, but the option only
    // permits a style rather than requiring it, and it is safe here because
    // this project only typechecks.
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "paths": {
      "codebase/configuration/*": ["./configuration/*"],
      "eslint-plugin-better-max-params": [
        "./configuration/types/eslint-plugin-better-max-params/index.d.ts"
      ]
    },
    "skipLibCheck": true
  },
  "exclude": [
    "applications",
    "configuration/conformetry-templates",
    "dist",
    "node_modules",
    "packages",
    "tmp",
    "tools"
  ],
  "extends": "./configuration/tsconfig.json",
  "include": [
    "*.ts",
    ".devcontainer/scripts/**/*.ts",
    "configuration/**/*.ts",
    "scripts/**/*.ts"
  ]
}
